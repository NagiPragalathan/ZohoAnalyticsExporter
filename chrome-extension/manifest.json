{
  "manifest_version": 3,
  "name": "Zoho Analytics Exporter",
  "version": "1.0.0",
  "description": "Auto-scrolls a Zoho Analytics view until every row is loaded, then exports the full dataset to Excel (.xlsx) or CSV.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://analytics.zoho.com/*",
        "https://analytics.zoho.eu/*",
        "https://analytics.zoho.in/*",
        "https://analytics.zoho.com.au/*",
        "https://analytics.zoho.com.cn/*",
        "https://analytics.zoho.jp/*",
        "https://analytics.zoho.ca/*",
        "https://analytics.zoho.uk/*",
        "https://analytics.zoho.sa/*",
        "https://analytics.zohocloud.ca/*"
      ],
      "js": ["src/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://analytics.zoho.com/*",
        "https://analytics.zoho.eu/*",
        "https://analytics.zoho.in/*",
        "https://analytics.zoho.com.au/*",
        "https://analytics.zoho.com.cn/*",
        "https://analytics.zoho.jp/*",
        "https://analytics.zoho.ca/*",
        "https://analytics.zoho.uk/*",
        "https://analytics.zoho.sa/*",
        "https://analytics.zohocloud.ca/*"
      ],
      "js": ["src/zip.js", "src/xlsx.js", "src/parser.js", "src/content.js"],
      "css": ["src/panel.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
